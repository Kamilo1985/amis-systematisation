function buildQuiz(config) {

    const data = config.data;
    const questionsContainer = document.getElementById(config.questionsId);
    const actionBtn = document.getElementById(config.actionId);
    const progressText = document.getElementById(config.progressTextId);
    const progressBar = document.getElementById(config.progressBarId);
    const quiz = document.getElementById(config.quizId);
    const results = document.getElementById(config.resultsId);
    const scoreElement = document.getElementById(config.scoreId);
    const resultMessage = document.getElementById(config.messageId);
    const restartBtn = document.getElementById(config.restartId);

    let current = 0;
    let score = 0;
    let validated = false;


    data.forEach((item, index) => {

        const question = document.createElement("div");

        question.className =
            "quiz-question" +
            (index === 0 ? " active" : "");

        const number = document.createElement("span");
        number.className = "question-number";
        number.textContent = "Question " + (index + 1);

        const title = document.createElement("h4");
        title.textContent = item.text;

        const options = document.createElement("div");
        options.className = "options";

        const values = item.options || ["qui", "que"];

        if (!item.options) {
            options.classList.add("two-options");
        }


        values.forEach((value, optionIndex) => {

            const option = document.createElement("div");
            option.className = "option";

            const input = document.createElement("input");
            input.type = "radio";
            input.name = config.prefix + index;
            input.value = value;
            input.id =
                config.prefix +
                index +
                "_" +
                optionIndex;

            const label = document.createElement("label");
            label.setAttribute("for", input.id);
            label.textContent = value;

            option.appendChild(input);
            option.appendChild(label);
            options.appendChild(option);

        });


        const warning = document.createElement("div");
        warning.className = "warning";
        warning.textContent =
            "Choisissez une réponse avant de continuer.";

        const feedback = document.createElement("div");
        feedback.className = "feedback";

        question.appendChild(number);
        question.appendChild(title);
        question.appendChild(options);
        question.appendChild(warning);
        question.appendChild(feedback);

        questionsContainer.appendChild(question);

    });


    function getQuestions() {
        return questionsContainer.querySelectorAll(".quiz-question");
    }


    function updateProgress() {

        progressText.textContent =
            (current + 1) +
            " / " +
            data.length;

        progressBar.style.width =
            ((current + 1) / data.length * 100) +
            "%";
    }


    function showQuestion(index) {

        getQuestions().forEach((question, i) => {
            question.classList.toggle("active", i === index);
        });

        validated = false;
        actionBtn.textContent = "Valider ma réponse";
        updateProgress();
    }


    function validate() {

        const question = getQuestions()[current];

        const selected =
            question.querySelector(
                'input[type="radio"]:checked'
            );

        const warning =
            question.querySelector(".warning");

        const feedback =
            question.querySelector(".feedback");


        if (!selected) {
            warning.style.display = "block";
            return;
        }


        warning.style.display = "none";

        const correctAnswer = data[current].answer;


        question
            .querySelectorAll('input[type="radio"]')
            .forEach(input => {

                input.disabled = true;

                const label =
                    question.querySelector(
                        'label[for="' +
                        input.id +
                        '"]'
                    );

                if (input.value === correctAnswer) {
                    label.classList.add("correct");
                }

                if (
                    input.checked &&
                    input.value !== correctAnswer
                ) {
                    label.classList.add("incorrect");
                }

            });


        if (selected.value === correctAnswer) {

            score++;

            feedback.className =
                "feedback correct-feedback";

            feedback.textContent =
                "Bonne réponse. " +
                data[current].explanation;

        } else {

            feedback.className =
                "feedback incorrect-feedback";

            feedback.textContent =
                "La bonne réponse est « " +
                correctAnswer +
                " ». " +
                data[current].explanation;

        }


        validated = true;


        if (current === data.length - 1) {
            actionBtn.textContent = "Voir mon résultat";
        } else {
            actionBtn.textContent = "Question suivante";
        }
    }


    function next() {

        if (current < data.length - 1) {

            current++;
            showQuestion(current);

        } else {

            quiz.style.display = "none";
            results.style.display = "block";

            scoreElement.textContent =
                score + " / " + data.length;

            const percentage =
                score / data.length;


            if (percentage === 1) {

                resultMessage.textContent =
                    "Excellent travail ! Toutes vos réponses sont correctes.";

            } else if (percentage >= .8) {

                resultMessage.textContent =
                    "Très bon travail ! Vous maîtrisez bien cette activité.";

            } else if (percentage >= .6) {

                resultMessage.textContent =
                    "Bon travail. Relisez les explications pour consolider vos acquis.";

            } else {

                resultMessage.textContent =
                    "Relisez les explications et les exemples, puis essayez de nouveau.";

            }
        }
    }


    function restart() {

        current = 0;
        score = 0;
        validated = false;


        getQuestions().forEach(question => {

            question
                .querySelectorAll('input[type="radio"]')
                .forEach(input => {

                    input.checked = false;
                    input.disabled = false;

                });


            question
                .querySelectorAll("label")
                .forEach(label => {

                    label.classList.remove(
                        "correct",
                        "incorrect"
                    );

                });


            const feedback =
                question.querySelector(".feedback");

            feedback.className = "feedback";
            feedback.textContent = "";

            question.querySelector(".warning").style.display = "none";

        });


        results.style.display = "none";
        quiz.style.display = "block";

        showQuestion(0);
    }


    actionBtn.addEventListener("click", () => {

        if (!validated) {
            validate();
        } else {
            next();
        }

    });


    restartBtn.addEventListener("click", restart);

    updateProgress();
}


